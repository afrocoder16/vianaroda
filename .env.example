# Copy this file to .env (local) or set these as environment variables on your host.
# NEVER commit the filled-in .env — it is gitignored.

# --- Database ---
# Local Postgres example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vinaroda?schema=public"

# --- NextAuth ---
# In production this MUST be the public URL of the deployed site, e.g. https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong, unique secret. Do NOT reuse the example value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (or)  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
