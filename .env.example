# Copy this file to .env (local) or set these as environment variables on your host.
# NEVER commit the filled-in .env — it is gitignored.

# --- Database (Supabase in production) ---
# Runtime connection. On Supabase, use the "Connection pooling" string
# (Transaction mode, port 6543) and append ?pgbouncer=true.
#   e.g. postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vinaroda?schema=public"

# Direct (non-pooled) connection used by Prisma for migrations.
# On Supabase, use the "Direct connection" string (port 5432).
# Locally, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vinaroda?schema=public"

# --- NextAuth ---
# In production this MUST be the public URL of the deployed site
# (e.g. https://your-app.vercel.app or your custom domain).
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong, unique secret. Do NOT reuse the example value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (or)  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# --- Image storage (Supabase Storage in production) ---
# When these are set, uploaded/imported images go to Supabase Storage.
# When unset (typical local dev), images fall back to the local
# public/uploads folder so `npm run dev` works with no external setup.
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-only secret, never expose
# SUPABASE_STORAGE_BUCKET="product-images"          # defaults to product-images
